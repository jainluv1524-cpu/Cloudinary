# ML Service
# Copy to .env.local and fill in real values

# Cloudinary (server-only)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Supabase (for model registry reads)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Internal JWT verification
INTERNAL_JWT_SECRET=

# Server
PORT=8000
HOST=0.0.0.0

# Model weights
WEIGHTS_DIR=./weights

# Sentry (optional)
SENTRY_DSN=
