# API Service
# Copy to .env.local and fill in real values

# Supabase
SUPABASE_URL=                    # https://your-project.supabase.co
SUPABASE_ANON_KEY=               # publishable, RLS-scoped
SUPABASE_SERVICE_KEY=            # server-only, never expose
SUPABASE_JWT_SECRET=             # for JWT verification

# Cloudinary (server-only)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=           # NEVER expose to clients
CLOUDINARY_UPLOAD_PRESET=verified_capture

# Redis / BullMQ
REDIS_URL=redis://localhost:6379

# ML Service
ML_SERVICE_URL=http://localhost:8000

# Internal JWT signing
INTERNAL_JWT_SECRET=             # for API → ML auth

# Server
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Sentry (optional)
SENTRY_DSN=
